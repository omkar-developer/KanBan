{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TaskFlow",
  "version": "0.1.0",
  "identifier": "com.taskflow.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TaskFlow",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "markdown",
        "ext": ["md"],
        "mimeType": "text/markdown"
      },
      {
        "name": "markdown",
        "ext": ["mdx"],
        "mimeType": "text/markdown"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}