{
  "name": "taskflow-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing TaskFlow (KanBan) boards, notes and tasks to AI apps via the local TaskFlow API",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "taskflow-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
